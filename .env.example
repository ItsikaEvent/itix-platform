# Copiez en ".env" et remplissez. Ne committez JAMAIS le vrai .env.

# --- PostgreSQL (docker compose construit DATABASE_URL tout seul) ---
POSTGRES_USER=billetterie
POSTGRES_PASSWORD=
POSTGRES_DB=billetterie

# --- Secrets (32 caractères minimum chacun) ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=FcAIOxZILwzucoCWl5s_fIn2IRzDHE1BU_1lp3mIcnDkTfZa_vzBc0HKxEvSINCU
QR_SECRET=

# --- Compte administrateur créé au démarrage ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- CORS : URL(s) du frontend, séparées par des virgules ---
CORS_ORIGINS=http://localhost:5173

# --- E-mail (Gmail SMTP en production / local) ---
