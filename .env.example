# Mot de passe d'application (16 caractères) sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=itsikaevent.mdg@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_16_caracteres
